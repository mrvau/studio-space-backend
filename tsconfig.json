{
	"compilerOptions": {
		/* Target & Environment */
		"target": "ES2022" /* Set modern JavaScript output matching your Node runtime */,
		"module": "NodeNext" /* Standard for modern Node.js module resolution */,
		"moduleResolution": "NodeNext" /* Works in tandem with NodeNext module setting */,
		"lib": ["ES2022"] /* Specify built-in JS library declarations */,

		/* Directories */
		"rootDir": "./src" /* Locate the root folder of your source files */,
		"outDir": "./dist" /* Redirect compile output to this folder */,

		/* Strict Type-Checking Options */
		"strict": true /* Enable all strict type-checking options */,
		"noImplicitAny": true /* Raise error on expressions with an implied 'any' type */,
		"strictNullChecks": true /* Enable strict null checks */,

		/* Module Compatibility */
		"esModuleInterop": true /* Allows default imports from CommonJS modules (like Express) */,
		"skipLibCheck": true /* Skip type checking of all declaration files (*.d.ts) */,
		"forceConsistentCasingInFileNames": true /* Disallow inconsistently-cased references to the same file */,

		/* Source Maps */
		"sourceMap": true /* Create source map files for debugging production code */
	},
	"include": ["src/**/*"] /* Tell TypeScript to only compile files inside /src */,
	"exclude": ["node_modules", "dist"] /* Folders to completely ignore during compilation */
}
